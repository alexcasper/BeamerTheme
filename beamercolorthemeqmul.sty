
%--------------------------------------
%  Color Settings
%--------------------------------------




% define custom colors
\definecolor{qmblue}{HTML}{21376A}
\definecolor{qmwhite}{HTML}{FFFFFF}
\definecolor{qmblack}{HTML}{000000}

\definecolor{qmpurple}{HTML}{7B0E72}
\definecolor{qmgreen}{HTML}{0C746A}
\definecolor{qmturquoise}{HTML}{1F7791}

\definecolor{qmred}{HTML}{BD1D1D}
\definecolor{qmorange}{HTML}{D35D0C}
\definecolor{qmyellow}{HTML}{CDA70A}



% customize colors for elements
\setbeamercolor{title}{bg=qmblue,fg=white}
\setbeamercolor{frametitle}{bg=qmblue,fg=white}
\setbeamercolor{block title}{fg=white,bg=qmblue}
\setbeamercolor{block body}{fg=black,bg=qmwhite}
\setbeamercolor{block title example}{fg=qmwhite,bg=qmgreen}
\setbeamercolor{block body example}{fg=qmblack,bg=qmwhite}
\setbeamercolor{block title alerted}{fg=qmwhite,bg=qmred}
\setbeamercolor{block body alerted}{fg=qmblack,bg=qmwhite}
\setbeamercolor{block title corollary}{fg=qmred,bg=qmred}
\setbeamercolor{block body corollary}{fg=qmred,bg=qmred}
\setbeamercolor{block title proof}{fg=qmred,bg=qmred}
\setbeamercolor{block body proof}{fg=qmred,bg=qmred}




\setbeamercolor{structure}{fg=qmblue}

\setbeamertemplate{block corollary}
{
  \begin{beamercolorbox}[sep=0.3cm]{block title corollary}
    \usebeamerfont{block title}\insertblocktitle
  \end{beamercolorbox}
  \begin{beamercolorbox}[sep=0.5cm]{block body corollary}
    \usebeamerfont{block body}\insertblockbody
  \end{beamercolorbox}
}


\setbeamertemplate{block proof}
{
  \begin{beamercolorbox}[sep=0.3cm]{block title proof}
    \usebeamerfont{block title}\insertblocktitle
  \end{beamercolorbox}
  \begin{beamercolorbox}[sep=0.5cm]{block body proof}
    \usebeamerfont{block body}\insertblockbody
  \end{beamercolorbox}
}

